    "./core/units": "./core/units.js",
    "./core/surface": "./core/surface.js",
    "./core/ability": "./core/ability.js",
    "./core/strength": "./core/strength.js",
    "./core/memory-class": "./core/memory-class.js",
    "./core/ability-model": "./core/ability-model.js",
    "./core/broker": "./core/broker.js",
    "./core/skill": "./core/skill.js",
    "./core/skill-builder": "./core/skill-builder.js",
    "./adapters/chrome/web-surface": "./adapters/chrome/web-surface.js",
    "./surfaces/web": "./surfaces/web.js",
    "./surfaces/xr": "./surfaces/xr.js",
    "./sync": "./sync/index.js",
    "./ports": "./ports/index.js"
  },
  "files": [
    "index.js",
