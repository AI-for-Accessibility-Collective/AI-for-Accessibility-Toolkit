# Upload only what the toolkit-service image needs (build context stays small).
# The Dockerfile copies toolkit/, server/ and the ai4a11y-toolkit skill.
*
!cloudbuild.yaml
!server/
!server/**
!toolkit/
!toolkit/**
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/ai4a11y-toolkit/
!.claude/skills/ai4a11y-toolkit/**
toolkit/node_modules/
toolkit/node_modules/**
server/data/
server/data/**
