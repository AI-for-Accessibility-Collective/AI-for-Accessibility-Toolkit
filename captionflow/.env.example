# Copy this file to captionflow/.env (which is gitignored).
# Available modes: fixture, local, hosted. The UI can also switch modes.
CAPTIONFLOW_AI_BACKEND=hosted
CAPTIONFLOW_WHISPER_MODEL=base
PORT=8787
CAPTIONFLOW_CAPTION_MAX_CHARS=48
CAPTIONFLOW_CAPTION_MAX_SECONDS=3.5
CAPTIONFLOW_CAPTION_MAX_WORDS=10
# Hosted Gemini gateway: use `gemini`, not `generic` (generic sends Bearer/multipart).
# For a different provider with a custom multipart ASR API, change to `generic`.
CAPTIONFLOW_HOSTED_PROTOCOL=gemini
# If you have API_KEY instead of CAPTIONFLOW_HOSTED_TOKEN, you can leave this blank.
CAPTIONFLOW_HOSTED_TOKEN=
CAPTIONFLOW_HOSTED_URL=
CAPTIONFLOW_HOSTED_MODEL=gemini-3.8-flash
CAPTIONFLOW_GEMINI_MAX_INLINE_MB=12

# Normally LEAVE THIS UNSET. Python is automatically found from an activated
# venv (any name/location), captionflow/.venv, captionflow/venv, repository/.venv,
# or PATH. For custom non-activated locations, uncomment either example:
# CAPTIONFLOW_PYTHON=captionflow/.venv/bin/python
# CAPTIONFLOW_PYTHON=/absolute/path/to/my-custom-environment/bin/python

# Example hackathon Gemini gateway URL (keep this in your private .env):
# CAPTIONFLOW_HOSTED_URL=https://ai4a11y.lovable.app/api/public/gemini
# API_KEY=... (or CAPTIONFLOW_HOSTED_TOKEN=...) — keep secrets OUT of Git.
# Other hosted ASR protocols must have their own matching URL/request format.
# Never commit live tokens or share your .env.